# Applies to every response Netlify serves. Netlify merges the most specific
# matching block, so the per-path cache rules below still apply on top of these.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite hashed assets — immutable, cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images in the root — long cache
/og-image.jpg
  Cache-Control: public, max-age=604800

/mark-mask.webp
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Service worker — always revalidate
/sw.js
  Cache-Control: no-cache

# HTML — short cache, always revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
